{
  "name": "@vmms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cloudflare:spike:build": "wrangler deploy --dry-run --config wrangler.spike.jsonc",
    "cloudflare:spike:dev": "wrangler dev --config wrangler.spike.jsonc --ip 127.0.0.1 --port 8787",
    "cloudflare:spike:run": "node --import tsx ../../scripts/cloudflare-api-spike.mjs",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "evidence:worker": "tsx src/evidence-worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:seed": "tsx scripts/seed.ts",
    "dev:link-auth": "tsx scripts/link-local-identity.ts",
    "dev:seed-browser-switch": "tsx scripts/seed-browser-switch-identity.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@fastify/cookie": "^11.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "file-type": "^22.3.0",
    "jose": "^6.2.16",
    "openid-client": "^6.8.9",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "wrangler": "^4.160.0"
  }
}
