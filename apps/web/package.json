{
  "name": "@vmms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/build-images.mjs && node scripts/build-brand-images.mjs",
    "predev": "npm run assets:generate",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --import tsx --test src/formatting.test.ts src/vin-scanner.test.ts src/drafts.test.ts src/worker.test.ts src/api.test.ts src/workspace-navigation.test.ts src/work-order-workflow-navigation.test.ts",
    "verify:workspace-navigation": "node ../../scripts/workspace-navigation-browser.mjs",
    "prebuild": "npm run assets:generate",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "build": "vite build",
    "cloudflare:dev": "vite --config vite.cloudflare.config.ts --host 127.0.0.1",
    "cloudflare:build": "npm run assets:generate && vite build --config vite.cloudflare.config.ts",
    "cloudflare:preview": "vite preview --config vite.cloudflare.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.68.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "^1.65.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "^4.160.0"
  }
}
