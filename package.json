{
  "name": "raymond-gray-vmms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev:web": "npm run dev --workspace @vmms/web",
    "dev:api": "npm run dev --workspace @vmms/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "node scripts/verify.mjs",
    "docs:check": "python scripts/project-status.py",
    "docs:generate": "python scripts/project-status.py --write",
    "verify:responsive": "npm run verify:responsive --workspace @vmms/web",
    "db:migrate": "npm run db:migrate --workspace @vmms/api",
    "dev:seed": "npm run dev:seed --workspace @vmms/api"
  }
}
