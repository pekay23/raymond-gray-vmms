# Local development only. Never reuse these database credentials in production.
MIGRATION_DATABASE_URL=postgresql://vmms_owner:vmms_local_development_only@127.0.0.1:55432/vmms
DATABASE_URL=postgresql://vmms_runtime:vmms_runtime_local_development_only@127.0.0.1:55432/vmms
# Provision this worker login separately and grant membership in vmms_evidence_worker.
# VMMS_EVIDENCE_WORKER_DATABASE_URL=postgresql://vmms_evidence_worker_login:replace-locally@127.0.0.1:55432/vmms
PORT=4100
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
STAFF_MESSAGES_ENABLED=false
# Leave empty for direct local access. Production must list exact trusted ingress IP/CIDR ranges.
TRUSTED_PROXY_CIDRS=
# Generate a random value locally for cookie signing. Production setup is a separate gate.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Shared identity development client; the local client secret is issued by the auth repo setup script.
OIDC_ISSUER=http://localhost:8080/realms/raymond-gray-dev
OIDC_CLIENT_ID=vmms-web-dev
OIDC_CLIENT_SECRET=replace-with-local-keycloak-client-secret
OIDC_CALLBACK_URL=http://127.0.0.1:4100/api/v1/auth/oidc/callback
OIDC_LOGOUT_CALLBACK_URL=http://127.0.0.1:4100/api/v1/auth/oidc/logout/callback
# Evidence object storage and scanner are optional; uploads fail closed unless configured.
VMMS_EVIDENCE_S3_ENDPOINT=http://127.0.0.1:19090
VMMS_EVIDENCE_S3_BUCKET=vmms-evidence
VMMS_EVIDENCE_S3_REGION=us-east-1
VMMS_EVIDENCE_S3_ACCESS_KEY_ID=local-test
VMMS_EVIDENCE_S3_SECRET_ACCESS_KEY=local-test-secret
# The worker has a separate object-store identity: read quarantine, copy to/read accepted.
VMMS_EVIDENCE_WORKER_S3_ACCESS_KEY_ID=local-worker-test
VMMS_EVIDENCE_WORKER_S3_SECRET_ACCESS_KEY=local-worker-test-secret
VMMS_EVIDENCE_CLAMAV_HOST=127.0.0.1
VMMS_EVIDENCE_CLAMAV_PORT=13310
# Scanner wait limit in milliseconds (1,000–60,000; default 60,000).
VMMS_EVIDENCE_CLAMAV_TIMEOUT_MS=60000
VMMS_EVIDENCE_MAX_UPLOAD_BYTES=10485760
VMMS_EVIDENCE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
